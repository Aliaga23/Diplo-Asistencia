# Copia este archivo como `.env` (no se versiona). Lo lee infra/opentofu/infra.ps1:
# solo toma las variables AWS_* y TF_VAR_*, solo para su propio proceso.
#
# Opción A: usuario IAM con access key (de TU cuenta)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=          # solo si son credenciales temporales
#
# Opción B: perfil de AWS CLI (IAM Identity Center/SSO o con claves). Deja vacías las de arriba.
# AWS_PROFILE=mi-perfil-sso   # infra.ps1 ejecuta `aws sso login` si la sesión expiró
#
# Región (opcional; por defecto la del perfil o us-east-1)
# AWS_REGION=us-east-1
#
# Variables de OpenTofu (opcionales)
# TF_VAR_app_domain=diplo.asistencia.ejemplo.com
# TF_VAR_name_prefix=presencia-clase2
