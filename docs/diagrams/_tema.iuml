' Tema formal: blanco y negro, sin colores decorativos
skinparam backgroundColor #FFFFFF
skinparam monochrome true
skinparam defaultFontName "Arial"
skinparam defaultFontSize 12
skinparam shadowing false
skinparam roundCorner 4
skinparam ArrowColor #000000
skinparam ArrowThickness 1
skinparam titleFontSize 15
skinparam titleFontStyle bold
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #000000
  HeaderBackgroundColor #E6E6E6
  FontColor #000000
  FontStyle bold
  AttributeFontColor #000000
  AttributeFontSize 11
}
skinparam entity {
  BackgroundColor #FFFFFF
  BorderColor #000000
  FontColor #000000
}
skinparam component {
  BackgroundColor #FFFFFF
  BorderColor #000000
  FontColor #000000
}
skinparam database {
  BackgroundColor #F2F2F2
  BorderColor #000000
  FontColor #000000
}
skinparam actor {
  BackgroundColor #FFFFFF
  BorderColor #000000
}
skinparam usecase {
  BackgroundColor #FFFFFF
  BorderColor #000000
  FontColor #000000
}
skinparam rectangle {
  BackgroundColor #FFFFFF
  BorderColor #000000
}
skinparam sequence {
  ParticipantBackgroundColor #FFFFFF
  ParticipantBorderColor #000000
  LifeLineBorderColor #808080
  GroupBackgroundColor #F2F2F2
  GroupBorderColor #000000
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #000000
}
