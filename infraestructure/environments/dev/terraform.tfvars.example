
# Proyecto
project_name = "presencia"
environment  = "dev"

# Cuenta AWS
expected_account_id = "123456789012"

# Region
aws_region = "us-east-1"

# Red
vpc_cidr           = "10.20.0.0/16"
public_subnet_cidr = "10.20.1.0/24"

# AZ opcional
availability_zone = null

# SSH
admin_cidrs = [
  "203.0.113.10/32"
]

# Clave publica SSH
ssh_public_key_path = "~/.ssh/presencia-aws.pub"

# Servidores
frontend_instance_type = "t3.small"
backend_instance_type  = "t3.micro"

# Almacenamiento
frontend_volume_size = 20
backend_volume_size  = 20

# Creditos CPU
cpu_credits = "standard"

# AMI Ubuntu automatica
ami_id = null

# Aplicacion que instala cloud-init
repo_url       = "https://github.com/Aliaga23/Diplo-Asistencia.git"
repo_branch    = "main"
load_demo_data = true

# Dominio opcional
app_domain = null
